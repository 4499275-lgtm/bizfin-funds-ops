{
  "name": "bizfin-funds-ops",
  "version": "3.0.0",
  "description": "业财一体资金运营平台 · 单账户日终收入勾兑（四层引擎生产版）",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/core/schema.sql dist/src/core/schema.sql",
    "start": "node dist/src/index.js",
    "dev": "npm run build && node dist/src/index.js",
    "cli": "node dist/src/cli.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "seed": "node dist/cli.js seed-demo",
    "smoke": "node dist/cli.js smoke"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^24.0.0"
  }
}